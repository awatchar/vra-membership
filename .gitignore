# Dependencies and build output
node_modules/
dist/
build/
coverage/
.wrangler/

# Local configuration and secrets
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
.secrets/
*.pem
*.key

# Local provider credentials and reference material.
# The whole directory stays out of Git: it holds vendor credentials and guides
# that must never be committed (see AGENTS.md).
#
# Anchored to the repository root with a leading slash. Written as `api/` it
# matched *any* directory named `api` at any depth, which silently excluded
# `src/web/api/` - the browser's whole API layer - from a commit. The build and
# the tests passed locally because the files were on disk; a clean checkout had
# no such directory at all.
/api/

# Editors and operating systems
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
