# Copy to .dev.vars for local Cloudflare Workers development.
# Never put real values in this file, and never commit .dev.vars.
#
# In production every name below is a Cloudflare Secret set with
# `wrangler secret put <NAME> --env production`. See docs/deployment.md.
IAPP_API_KEY=
SLIPOK_API_KEY=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Random value of at least 32 bytes, e.g. `openssl rand -base64 48`.
# Used verbatim as HKDF input, so it must never change once data exists.
PII_ENCRYPTION_KEY=

# Operational configuration. Not cryptographic secrets, but still set through
# Cloudflare rather than committed, because they carry association details.
MANAGER_EMAIL=
EMAIL_FROM=
VRA_BANK_NAME=
VRA_BANK_ACCOUNT=
VRA_BANK_ACCOUNT_NAME=
