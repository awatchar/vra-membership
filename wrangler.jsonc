/**
 * Wrangler configuration for the VRA membership Worker.
 *
 * Rules:
 * - This file is committed. It must never contain secrets, API keys, encryption
 *   keys, bank account details, or any personal data.
 * - Secrets live in Cloudflare Secrets (`wrangler secret put <NAME>`) and, for
 *   local development, in the git-ignored `.dev.vars` file. See `.env.example`.
 * - The D1 `database_id` values below are real but are not secrets: they only
 *   identify a database, and access still requires an authenticated token.
 *   Committing them is what makes a clean checkout deployable.
 */
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vra-membership",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  // The receipt PDF embeds a Thai font, which has to reach the Worker as bytes.
  // Without this rule the .ttf import is treated as text and the font is
  // corrupted in a way that only shows up as unreadable output.
  "rules": [{ "type": "Data", "globs": ["**/*.ttf"], "fallthrough": false }],
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "ENVIRONMENT": "development",
    "PROVIDER_MODE": "mock",
    "APP_BASE_URL": "http://localhost:8787"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vra-membership-dev",
      "database_id": "73c5ef46-3923-4216-b2cd-874655d008c8",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEMBER_PHOTOS",
      "bucket_name": "vra-member-private-dev"
    }
  ],
  "env": {
    "production": {
      "name": "vra-membership",
      "triggers": {
        // Daily at 02:17 Asia/Bangkok (19:17 UTC). The non-round minute avoids
        // the busiest edge of the hour while keeping the cleanup predictable.
        "crons": ["17 19 * * *"]
      },
      "routes": [
        {
          "pattern": "member.vra.or.th",
          "custom_domain": true
        }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "PROVIDER_MODE": "live",
        "APP_BASE_URL": "https://member.vra.or.th"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "vra-membership-prod",
          "database_id": "cc6ace9f-77af-41a0-833b-55ec8595e2a7",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEMBER_PHOTOS",
          "bucket_name": "vra-member-private"
        }
      ]
    }
  }
}
