{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2023"],
    "types": ["@cloudflare/vitest-pool-workers/types"],
    "outDir": "./dist/types/worker",
    "tsBuildInfoFile": "./dist/types/worker/.tsbuildinfo"
  },
  "include": [
    "src/worker/**/*.ts",
    "src/shared/**/*.ts",
    "tests/worker/**/*.ts",
    "tests/unit/**/*.ts",
    "tests/support/**/*.ts",
    "tests/setup/storage.ts",
    "worker-configuration.d.ts"
  ]
}
